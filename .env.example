# ---- MongoDB Atlas (MANDATORY: the hackathon sandbox, org "SFTW: Harness Engineering & Model Wrangling Hackathon") ----
MONGODB_URI=            # writer user, worker only: mongodb+srv://mm_worker:<pw>@<cluster>.mongodb.net/?appName=mongomation
MONGODB_URI_WEB=        # dashboard user: read on mongomation.*, readWrite on mongomation.jobs only
MONGODB_DB=mongomation
MDB_MCP_CONNECTION_STRING=   # read-only user for the MongoDB MCP server (dev inspection)

# ---- Models ----
ANTHROPIC_API_KEY=
MODEL_STRONG=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5

# ---- Embeddings for Atlas Vector Search (optional; retrieval degrades to recency without it) ----
EMBEDDING_MODE=auto       # auto = Atlas Automated Embedding (no key); voyage = bring-your-own; off
VOYAGE_API_KEY=          # only for EMBEDDING_MODE=voyage (Atlas model keys use https://ai.mongodb.com/v1)
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMS=1024

# ---- Raindrop (agent observability) ----
RAINDROP_WRITE_KEY=          # ingest (SDK); the SDK does not read env itself — the worker passes it
RAINDROP_PROJECT_ID=         # optional project slug
RAINDROP_QUERY_API_KEY=      # read side (Query API / MCP) for RSI evidence

# ---- Rig on AWS (from Developer 1; private network only — see docs/INTEGRATION_CONTRACT.md) ----
OPENPLC_FLAVOR=v3            # v3 | v4
OPENPLC_URL=                 # e.g. http://10.0.1.20:8080 (v3) or https://10.0.1.20:8443 (v4)
OPENPLC_USER=
OPENPLC_PASSWORD=
OPENPLC_INSECURE_TLS=false   # v4 ships a self-signed cert; set true only inside the VPC
FACTORYIO_URL=               # e.g. http://10.0.1.10:7410
RIG_ID=rig-1
SCENE_ID=                    # registered scene id, e.g. sorting-by-height-basic
DCV_URL=                     # Amazon DCV web URL for the 3D view (team-only access)

# ---- Local preflight compiler (MatIEC iec2c, docs/SETUP.md §3) ----
IEC2C_PATH=
IEC_LIB=
OPENPLC_C_LIB=

# ---- Worker identity ----
WORKER_ID=
