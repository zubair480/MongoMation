# ---- MongoDB Atlas (MANDATORY: the hackathon sandbox, org "SFTW: Harness Engineering & Model Wrangling Hackathon") ----
MONGODB_URI=            # writer user, worker only: mongodb+srv://mm_worker:<pw>@<cluster>.mongodb.net/?appName=mongomation
MONGODB_URI_WEB=        # dashboard user: read on mongomation.*, readWrite on mongomation.jobs only
MONGODB_DB=mongomation
MDB_MCP_CONNECTION_STRING=   # read-only user for the MongoDB MCP server (dev inspection)

# ---- Models ----
ANTHROPIC_API_KEY=
MODEL_STRONG=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5

# ---- Embeddings for Atlas Vector Search (optional; retrieval degrades to recency without it) ----
EMBEDDING_MODE=auto       # auto = Atlas Automated Embedding (no key); voyage = bring-your-own; off
VOYAGE_API_KEY=          # only for EMBEDDING_MODE=voyage (Atlas model keys use https://ai.mongodb.com/v1)
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMS=1024
# VOYAGE_BASE_URL=https://ai.mongodb.com/v1   # optional override (default shown)

# ---- Raindrop (agent observability) ----
RAINDROP_WRITE_KEY=          # ingest (SDK); the SDK does not read env itself — the worker passes it
RAINDROP_PROJECT_ID=         # optional project slug
RAINDROP_QUERY_API_KEY=      # read side (Query API / MCP) for RSI evidence; not read by the worker code
# RAINDROP_DEBUG=true        # optional: SDK debug logs

# ---- Rig on AWS (Developer 1's AUTOMINUS rig, us-west-2; private network only — see docs/INTEGRATION_CONTRACT.md + docs/SETUP.md §5) ----
# Reached through AWS SSM port forwarding run INSIDE WSL (scripts/rig-tunnels.sh start; WSL NAT cannot see Windows tunnels).
# Instance id, Factory I/O private IP and DCV URL are in the private ENDPOINTS.md handoff, never in this repo.
# RIG_* are read by scripts/rig-tunnels.sh + scripts/rig-env.sh only (not by the worker):
RIG_INSTANCE=                # EC2 instance id of the rig (from the private handoff)
RIG_FIO_HOST=                # Factory I/O sim host private IP (from the private handoff)
RIG_REGION=us-west-2
OPENPLC_FLAVOR=v4            # v3 | v4 | v3-web   (the live rig is OpenPLC Runtime v4)
OPENPLC_URL=https://localhost:8443   # SSM tunnel; on the Linux rig host itself: https://127.0.0.1:8443
OPENPLC_USER=autominus
OPENPLC_PASSWORD=            # NEVER commit. Load per shell: source scripts/rig-env.sh (reads the SSM parameter below)
OPENPLC_PASSWORD_SSM_PARAM=/autominus/openplc-api-password   # read by scripts/rig-env.sh only
OPENPLC_INSECURE_TLS=true    # v4 ships a self-signed cert; traffic stays inside the SSM tunnel
OPENPLC_MODBUS_MODE=server   # server = Factory I/O is the Modbus CLIENT polling OpenPLC's server (live rig): upload ships NO conf/modbus_master.json
                             # master = OpenPLC polls Factory I/O's Modbus server: upload ships conf/modbus_master.json
                             # (code default when unset: server)
OPENPLC_BUILDER=strucpp      # strucpp (in-process STruC++ npm package, docs/SETUP.md §4) | docker:plc-builder (only when the worker runs on the Linux rig host)
FACTORYIO_URL=http://localhost:7410   # SSM tunnel to <RIG_FIO_HOST>:7410; on the rig host: http://<RIG_FIO_HOST>:7410
FACTORYIO_TIMEOUT_MS=15000  # per-call Web API timeout (the API takes ~0.3-1 s per call, more under load)
FACTORYIO_RELINK_MS=65000   # Factory I/O drops the Modbus link ~60 s after every upload; wait this long before judging plant behaviour
FACTORYIO_MODBUS_HOST=       # master mode only: Factory I/O host for conf/modbus_master.json
FACTORYIO_MODBUS_PORT=502    # master mode only
FACTORYIO_MODBUS_SLAVE_ID=1  # master mode only
RIG_ID=rig-1
SCENE_ID=sorting-by-height-basic   # I/O map verified live by Developer 1
DCV_URL=                     # Amazon DCV web URL for the 3D view (owner-allowlisted IPs only; URL is in the private handoff)

# ---- Local preflight compiler (MatIEC iec2c, optional, docs/SETUP.md §3; unset = preflight "unavailable", never a pass) ----
IEC2C_PATH=                  # absolute path to the iec2c binary
IEC_LIB=                     # MatIEC ST library dir (matiec_src/lib)
OPENPLC_C_LIB=               # optional: C headers for the g++ -c step

# ---- Worker identity ----
WORKER_ID=                   # optional; default worker-<hostname>-<pid>
