{
  "name": "mongomation",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "checks",
    "apps/worker"
  ],
  "scripts": {
    "typecheck": "tsc -p packages/types && tsc -p checks && tsc -p apps/worker && tsc -p scripts",
    "test": "node --import tsx --test \"checks/test/**/*.test.ts\" \"apps/worker/test/**/*.test.ts\"",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "green": "tsx --env-file-if-exists=.env scripts/green-check.ts",
    "setup:atlas": "tsx --env-file-if-exists=.env scripts/setup-atlas.ts",
    "seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight-st.ts",
    "worker": "tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "launcher": "tsx --env-file-if-exists=.env apps/worker/src/launcher.ts",
    "example": "tsx --env-file-if-exists=.env scripts/run-example.ts",
    "fault": "tsx --env-file-if-exists=.env scripts/inject-fault.ts",
    "evolve": "tsx --env-file-if-exists=.env scripts/evolve.ts",
    "benchmark": "tsx --env-file-if-exists=.env scripts/evolve.ts --benchmark-only",
    "ablation": "tsx --env-file-if-exists=.env scripts/evolve.ts --ablation",
    "rig:smoke": "tsx --env-file-if-exists=.env scripts/rig-smoke.ts",
    "ledger": "tsx --env-file-if-exists=.env scripts/evidence-ledger.ts",
    "export": "tsx --env-file-if-exists=.env scripts/export-project.ts",
    "probe": "tsx scripts/gen-probe.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
